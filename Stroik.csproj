<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Stroik</AssemblyName>
    <RootNamespace>Stroik</RootNamespace>
    <Version>1.0.24</Version>
    <Product>Stroik</Product>
    <Authors>Proszczok</Authors>
    <Description>Accessible instrument tuner for blind and visually impaired musicians / Dostępny stroiciel instrumentów dla osób niewidomych i słabowidzących.</Description>
    <Copyright>Copyright (c) 2026 Proszczok</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="THIRD_PARTY_NOTICES.md" LogicalName="Stroik.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="NVDA-LGPL-2.1.txt" LogicalName="Stroik.NVDA-LGPL-2.1.txt" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="dist/**/*.cs" />
    <Compile Remove="niepotrzebne/**/*.cs" />
    <EmbeddedResource Include="RELEASE_NOTES.md" LogicalName="Stroik.RELEASE_NOTES.md" />
    <EmbeddedResource Include="vendor/nvda/nvdaControllerClient.dll" LogicalName="Stroik.nvdaControllerClient.dll" />
    <EmbeddedResource Include="locales/*.json" Exclude="locales/source*.json" LogicalName="Stroik.locale.%(Filename).json" />
  </ItemGroup>
</Project>
